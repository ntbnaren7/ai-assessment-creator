# =========================================
# Operating System Files
# =========================================
# Why: Prevents OS-specific indexing metadata from polluting the repo across teams.
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# =========================================
# IDEs and Editors
# =========================================
# Why: Engineer-specific workspace configs must never leak to other team members.
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*~
.vim/

# =========================================
# Scratch & Local Utilities
# =========================================
# Why: Allows engineers to keep local notes without accidentally committing them.
scratch/
temp/
*.log
